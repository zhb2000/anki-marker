{
  "identifier": "com.zhb2000.anki-marker",
  "productName": "anki-marker",
  "mainBinaryName": "anki-marker",
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libayatana-appindicator3-1 | libappindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "(libayatana-appindicator-gtk3 or libappindicator-gtk3)"
        ]
      }
    }
  }
}
