# 开发调试用的 mock 场景配置示例。
# 实际配置请复制到 .env.development.local（被 gitignore，不会误提交），
# 修改后需要重启 dev server 才能生效。可用场景见 src/logics/debug.ts。

# 应用更新检查：real | new-version | no-update | request-error
#VITE_APP_UPDATE_SCENARIO=new-version

# 笔记模板版本获取：real | low-version | request-error
#VITE_TEMPLATE_VERSION_SCENARIO=low-version
